                "type": "text/javascript",
                "exec": [
                  "var requestId = String(pm.environment.get('requestId'));",
                  "var rows = pm.response.json().items || [];",
                  "var match;",
                  "rows.forEach(function (row) { if (String(row.request_id) === requestId) { match = row; } });",
                  "pm.test('fusion create job found for request', function () { pm.expect(match === undefined).to.eql(false); });",
