  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('testToken')) {",
          "  pm.environment.set('testToken', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Health and Reads",
      "item": [
        {
          "name": "Service Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('service index returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('service name is supplier-onboarding-ords', function () { pm.expect(pm.response.json().service_name).to.eql('supplier-onboarding-ords'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health returns ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Requests as Requester",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests?actor_subject_id={{requesterSubject}}&actor_roles=REQUESTER&limit=10&offset=0"
          }
        },
        {
          "name": "List Requests as Reviewer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests?actor_subject_id={{reviewerSubject}}&actor_roles=REVIEWER&limit=10&offset=0"
          }
        },
        {
          "name": "List Requests as Admin",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/requests?actor_subject_id={{adminSubject}}&actor_roles=ADMIN&limit=10&offset=0"
          }
        },
        {
          "name": "List Risk Rules",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/risk-rules?actor_subject_id={{adminSubject}}&actor_roles=ADMIN"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var rows = pm.response.json().items || [];",
                  "var total = 0;",
                  "rows.forEach(function (row) { if (row.active === 'Y') { total += Number(row.weight || 0); } });",
                  "pm.test('active risk weights total 100', function () { pm.expect(total).to.eql(100); });"
