              }
            }
          ]
        },
        {
          "name": "List High Risk Countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/high-risk-countries?actor_subject_id={{adminSubject}}&actor_roles=ADMIN"
          }
