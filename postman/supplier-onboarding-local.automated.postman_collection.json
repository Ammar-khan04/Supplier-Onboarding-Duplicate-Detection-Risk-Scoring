          "name": "List Integration Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/integration-logs?actor_subject_id={{adminSubject}}&actor_roles=ADMIN"
          }
        },
        {
          "name": "Poll Ready AI Explanation Jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/integration-jobs?type=AI_EXPLANATION&status=READY&limit=25"
